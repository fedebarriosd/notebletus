# Copiar este archivo a .env y completar con credenciales propias (no subir .env al repositorio).
# En el despliegue estas variables se configuran en el panel de la plataforma, no en un archivo.

# Cadena de conexión de MongoDB Atlas (o MongoDB local: mongodb://127.0.0.1:27017/notebletus)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/notebletus

# Upstash Redis (rate limiting). Crear una base gratuita en https://console.upstash.com
UPSTASH_REDIS_REST_URL=<your_redis_rest_url>
UPSTASH_REDIS_REST_TOKEN=<your_redis_rest_token>

# "development" en local (habilita CORS para http://localhost:5173).
# "production" en el despliegue (el backend sirve el frontend compilado desde frontend/dist).
NODE_ENV=development

# Opcional. La mayoría de plataformas (Render, Railway) lo inyectan solas. Por defecto: 5001.
# PORT=5001
